<?xml version="1.0" encoding="UTF-8"?>
<plugin>
    <!-- Main plugin class -->
    <class>org.igniterealtime.openfire.spiffing.SpiffingPlugin</class>
    <!-- Plugin metadata -->
    <name>${project.name}</name>
    <description>${project.description}</description>
    <author>Spiffing contributors</author>
    <licenseType>apache</licenseType>
    <version>${project.version}</version>
    <!-- set release date here -->
    <date>2026-09-09</date>
    <!-- Minimal supported Openfire version, same as Maven "plugins" parent pom -->
    <minServerVersion>5.0.0</minServerVersion>
    <minJavaVersion>17</minJavaVersion>

    <!-- Admin console entries -->
    <adminconsole>
        <tab id="tab-server">
            <sidebar id="sidebar-server-settings">
                <item id="spiffing-settings"
                      name="Spiffing security labels"
                      url="spiffing-settings.jsp"
                      description="Server security policy, clearance and default message label"/>
            </sidebar>
        </tab>
    </adminconsole>
</plugin>
